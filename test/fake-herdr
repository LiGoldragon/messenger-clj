#!/usr/bin/env bash
set -euo pipefail
pane="p"
if [[ -n "${FAKE_HERDR_STATE:-}" && -f "$FAKE_HERDR_STATE" ]]; then pane="$(<"$FAKE_HERDR_STATE")"; fi
record_prompt() {
  if [[ -n "${FAKE_HERDR_PROMPT_LOG:-}" ]]; then printf '%s\n' "$6" >> "$FAKE_HERDR_PROMPT_LOG"; fi
}
case "$*" in
  "session list --json")
    if [[ "${FAKE_HERDR_LIST:-ok}" == fail ]]; then printf '%s\n' '{"error":{"code":"unavailable"}}'; exit 1; fi
    printf '{"sessions":[{"name":"s","running":true,"socket_path":"%s"}]}\n' "$XDG_CONFIG_HOME/herdr/sessions/s/herdr.sock" ;;
  "--session s agent list")
    if [[ "${FAKE_HERDR_AGENT_LIST:-live}" == empty ]]; then printf '%s\n' '{"agents":[]}'; else
      printf '{"agents":[{"name":"Mind Sol 00f95a","pane_id":"%s","terminal_id":"t","agent":"codex","agent_session":{"source":"herdr:codex","kind":"id","agent":"codex","value":"00000000-0000-0000-0000-000000000000"},"agent_status":"working"}]}\n' "$pane"
    fi ;;
  "--session s agent get "*)
    case "${FAKE_HERDR_AGENT_SESSION:-valid}" in
      valid) session=',"agent_session":{"source":"herdr:codex","kind":"id","agent":"codex","value":"00000000-0000-0000-0000-000000000000"}' ;;
      absent) session='' ;;
      malformed) session=',"agent_session":{"source":"herdr:claude","kind":"id","agent":"codex","value":"--dangerously-skip-permissions"}' ;;
    esac
    printf '{"agent":{"name":"Mind Sol 00f95a","pane_id":"%s","terminal_id":"t","agent":"codex"%s,"agent_status":"working"}}\n' "$pane" "$session" ;;
  "--session s pane process-info --pane "*)
    printf '%s\n' '{"process_info":{"foreground_processes":[{"pid":123,"argv":["codex","--dangerously-skip-permissions","--thread","00000000-0000-0000-0000-000000000000"]}]}}' ;;
  "--session s pane get "*)
    printf '{"pane":{"pane_id":"%s","terminal_id":"t","agent":"codex","workspace_id":"%s"}}\n' "$pane" "$(if [[ "$pane" == p ]]; then printf w1; else printf w2; fi)" ;;
  "--session s pane move "*"--new-tab --workspace w2 --label Mind Sol 00f95a --no-focus")
    [[ -n "${FAKE_HERDR_STATE:-}" ]] && printf '%s' m > "$FAKE_HERDR_STATE"
    printf '%s\n' '{"move_result":{"previous_pane_id":"p","previous_workspace_id":"w1","pane":{"pane_id":"m","terminal_id":"t","agent":"codex","workspace_id":"w2"}}}' ;;
  "--session s agent send-keys "*" esc"|"--session s agent send-keys "*" enter") printf '%s\n' '{"result":{"ok":true}}' ;;
  *"agent prompt "*"--wait"*)
    record_prompt "$@"
    case "${FAKE_HERDR_WAIT:-presented}" in
      presented) printf '{"id":"cli:agent:prompt","result":{"type":"agent_prompted","agent":{"name":"Mind Sol 00f95a","pane_id":"%s","terminal_id":"t","agent":"codex","agent_status":"idle"}}}\n' "$pane" ;;
      submitted) printf '%s\n' '{"result":{"ok":true}}' ;;
      timeout) printf '%s\n' '{"error":{"code":"agent_prompt_stalled"}}'; exit 1 ;;
    esac ;;
  *"agent prompt "*) record_prompt "$@"; printf '{"id":"cli:agent:prompt","result":{"type":"agent_prompted","agent":{"name":"Mind Sol 00f95a","pane_id":"%s","terminal_id":"t","agent":"codex","agent_status":"working"}}}\n' "$pane" ;;
  *) printf '%s\n' '{"error":{"code":"unexpected"}}'; exit 1 ;;
esac
